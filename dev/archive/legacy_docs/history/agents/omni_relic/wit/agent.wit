package aaroneous:agent;

interface bus {
    subscribe: func(topic: string) -> result<u32, string>;
    publish: func(topic: string, data: list<u8>) -> result<list<u8>, string>;
    receive: func() -> result<tuple<string, list<u8>>, string>;
}

interface llm {
    embed: func(text: string) -> result<list<f32>, string>;
}

interface specialist {
    process: func() -> result<string, string>;
}

world omni-relic {
    import bus;
    import llm;
    export specialist;
}