package aaroneous:sab;

interface core {
    /// Returns a JSON string describing the capabilities, inputs, and outputs of this SAB.
    /// This is used by Omni Relic to understand what this plugin can do.
    describe: func() -> string;
    
    /// Executes a specific function of the wrapped open-source crate.
    /// `command`: The specific tool/function name.
    /// `payload`: JSON string of arguments.
    /// Returns: JSON string of results or error.
    execute: func(command: string, payload: string) -> result<string, string>;
}

world sab-plugin {
    export core;
}