name: Deploy Aaroneous Federation (Aspirational - Manual Trigger Only)

# NOTE: This workflow targets a future deployment scenario with PostgreSQL/Redis
# services and Docker registry pushes. It will fail in current state because:
# - The codebase uses SQLite, not PostgreSQL
# - Redis is not used in current architecture
# - Clippy has many existing warnings (-D warnings will fail)
# - Code is not yet rustfmt-clean
#
# Use `ci.yml` for actual CI on every push. This workflow is preserved for
# the future when those infrastructure pieces are in place.
on:
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy to'
        required: true
        default: 'staging'
        type: choice
        options:
          - staging
          - production

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}
  RUST_BACKTRACE: 1
  CARGO_TERM_COLOR: always

jobs:
  # Code Quality & Security
  quality:
    runs-on: ubuntu-latest
    name: Code Quality & Security
    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo
        uses: Swatinem/rust-cache@v2

      - name: Run clippy
        run: cargo clippy --all-features -- -D warnings

      - name: Format check
        run: cargo fmt -- --check

      - name: Security audit
        uses: rustsec/audit-check-action@v1
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

  # Unit Tests
  test:
    runs-on: ubuntu-latest
    name: Unit Tests
    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: aaroneous_test
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379

    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo
        uses: Swatinem/rust-cache@v2

      - name: Run tests
        run: cargo test --lib --all-features --verbose
        env:
          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/aaroneous_test
          REDIS_URL: redis://localhost:6379

      - name: Run doc tests
        run: cargo test --doc --all-features

      - name: Test coverage
        uses: taiki-e/cargo-tarpaulin@v0.1
        with:
          args: '--out Html --all-features'

      - name: Upload coverage
        uses: codecov/codecov-action@v3
        with:
          files: ./coverage.html
          flags: unittests
          name: codecov-umbrella

  # Integration Tests
  integration:
    runs-on: ubuntu-latest
    name: Integration Tests
    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: aaroneous_test
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379

    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo
        uses: Swatinem/rust-cache@v2

      - name: Run integration tests
        run: cargo test --test '*' --all-features --verbose
        env:
          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/aaroneous_test
          REDIS_URL: redis://localhost:6379

  # Build Docker Image
  build:
    needs: [quality, test, integration]
    runs-on: ubuntu-latest
    name: Build Docker Image
    permissions:
      contents: read
      packages: write

    steps:
      - uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2

      - name: Log in to Container Registry
        uses: docker/login-action@v2
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v4
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=sha
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build and push Docker image
        uses: docker/build-push-action@v4
        with:
          context: .
          push: ${{ github.event_name != 'pull_request' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  # Deploy to Staging
  deploy-staging:
    needs: build
    runs-on: ubuntu-latest
    name: Deploy to Staging
    if: github.ref == 'refs/heads/develop'
    environment:
      name: staging
      url: https://staging.aaroneous.example.com

    steps:
      - uses: actions/checkout@v4

      - name: Configure kubectl
        run: |
          echo "${{ secrets.KUBECONFIG_STAGING }}" | base64 -d > $HOME/.kube/config
          chmod 600 $HOME/.kube/config

      - name: Deploy with Helm
        run: |
          helm repo add aaroneous https://charts.aaroneous.ai
          helm repo update
          helm upgrade --install aaroneous-federation aaroneous/aaroneous-federation \
            --values deploy/helm/values-staging.yaml \
            --namespace aaroneous \
            --create-namespace \
            --wait \
            --timeout 5m

      - name: Wait for rollout
        run: |
          kubectl rollout status deployment/aaroneous-federation \
            -n aaroneous --timeout=5m

      - name: Run smoke tests
        run: |
          POD=$(kubectl get pods -n aaroneous -l app=aaroneous-federation -o jsonpath='{.items[0].metadata.name}')
          kubectl exec -n aaroneous $POD -- aaroneous --health-check

      - name: Notify Slack
        if: always()
        uses: slackapi/slack-github-action@v1.24.0
        with:
          payload: |
            {
              "text": "Staging Deployment",
              "blocks": [
                {
                  "type": "section",
                  "text": {
                    "type": "mrkdwn",
                    "text": "*Aaroneous Federation - Staging Deployment*\nStatus: ${{ job.status }}\nRef: ${{ github.ref }}\nSHA: ${{ github.sha }}"
                  }
                }
              ]
            }
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}

  # Deploy to Production
  deploy-production:
    needs: build
    runs-on: ubuntu-latest
    name: Deploy to Production
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    environment:
      name: production
      url: https://aaroneous.example.com
    concurrency:
      group: production-deployment
      cancel-in-progress: false

    steps:
      - uses: actions/checkout@v4

      - name: Configure kubectl
        run: |
          echo "${{ secrets.KUBECONFIG_PRODUCTION }}" | base64 -d > $HOME/.kube/config
          chmod 600 $HOME/.kube/config

      - name: Create backup
        run: |
          velero backup create aaroneous-pre-deploy-$(date +%Y%m%d-%H%M%S) \
            --include-namespaces aaroneous

      - name: Deploy with Helm
        run: |
          helm repo add aaroneous https://charts.aaroneous.ai
          helm repo update
          helm upgrade --install aaroneous-federation aaroneous/aaroneous-federation \
            --values deploy/helm/values-production.yaml \
            --namespace aaroneous \
            --create-namespace \
            --wait \
            --timeout 10m

      - name: Wait for rollout
        run: |
          kubectl rollout status deployment/aaroneous-federation \
            -n aaroneous --timeout=10m

      - name: Run smoke tests
        run: |
          POD=$(kubectl get pods -n aaroneous -l app=aaroneous-federation -o jsonpath='{.items[0].metadata.name}')
          kubectl exec -n aaroneous $POD -- aaroneous --health-check

      - name: Verify federation
        run: |
          kubectl logs -n aaroneous -l app=aaroneous-federation \
            | grep -i "consensus\|federation\|hive" | tail -20

      - name: Notify Slack
        if: always()
        uses: slackapi/slack-github-action@v1.24.0
        with:
          payload: |
            {
              "text": "Production Deployment",
              "blocks": [
                {
                  "type": "section",
                  "text": {
                    "type": "mrkdwn",
                    "text": "*Aaroneous Federation - Production Deployment*\nStatus: ${{ job.status }}\nRef: ${{ github.ref }}\nSHA: ${{ github.sha }}"
                  }
                }
              ]
            }
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}

      - name: Create release
        if: success()
        uses: softprops/action-gh-release@v1
        with:
          files: target/release/aaroneous
          draft: false
          prerelease: false
