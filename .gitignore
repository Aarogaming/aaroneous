# Build artifacts (all target directories, including nested ones in enzymes/)
target/
**/target/
# Cargo.lock is intentionally committed for binary crates (reproducible builds)
# See: https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control

# Model files (use Git LFS or download separately)
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
data/test_*.gguf
data/models/

# Submodules build artifacts
src/enzymes/*/target/
src/submodules/*/target/

# Compiled binaries
bin/*.exe
bin/*.dll
bin/*.so
bin/*.dylib

# Database files
*.db
hive.db

# Test and build outputs
test_*.txt
build_output.txt
test_results.txt
test_full.txt

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.log
/cache/
/logs/

# OS specific
thumbs.db

exports/

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
*.cer
*.p12
*.pfx
*.jks
*.keystore
secrets.yml
secrets.yaml
secrets.json
terraform.tfvars
*.tfvars
*.tfstate
*.tfstate.backup

# Nested git repositories (sub-projects)
**/.git/

# Node modules
node_modules/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Large binary assets
*.dll
*.wasm
data/sabs/

# Nested git repositories in source materials
AAS/
monitoring/

# Orphaned legacy src directory (code moved to core/ and components/)
src/
!core/hypervisor/src/

# Synapse shared memory files
*.synapse

# Data directory (databases, cached models)
data/*.db
data/*.sqlite
data/models/

# Config directory
config/*.toml
!config/example.toml

# Scripts directory - setup artifacts, not source
scripts/*.zip
scripts/*.log
scripts/*.txt

# Local opencode session/agent state
.opencode/

# Local model library (very large GGUF/safetensors; not externalized to LFS)
genetics/
