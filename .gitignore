# Build artifacts (all target directories, including nested ones in enzymes/)
target/
**/target/
# Cargo.lock is intentionally committed for binary crates (reproducible builds)
# See: https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control

# Model files (use Git LFS or download separately)
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
data/test_*.gguf
data/models/

# Submodules build artifacts
src/enzymes/*/target/
src/submodules/*/target/

# Compiled binaries
bin/*.exe
bin/*.dll
bin/*.so
bin/*.dylib

# Database files
*.db
hive.db

# Test and build outputs
test_*.txt
build_output.txt
test_results.txt
test_full.txt

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.log
/cache/
/logs/

# OS specific
thumbs.db
