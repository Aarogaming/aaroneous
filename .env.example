# Copy this file to .env and fill in real values before running docker-compose.
# .env is git-ignored — never commit a file containing real credentials.

# ──────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────
# Strong, unique password for the Postgres 'aaroneous' user.
POSTGRES_PASSWORD=change_me_before_use

# ──────────────────────────────────────────
# Grafana
# ──────────────────────────────────────────
# Admin password for the Grafana dashboard. Must be set explicitly — no default is provided.
GF_SECURITY_ADMIN_PASSWORD=change_me_before_use

# ──────────────────────────────────────────
# Aaroneous API key (optional)
# ──────────────────────────────────────────
# When set, every request to the API must include:
#   Authorization: Bearer <value>
# Leave unset to disable auth (development only).
# AARONEOUS_API_KEY=

# ──────────────────────────────────────────
# LLM providers (optional)
# ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# PINECONE_API_KEY=
# DATADOG_API_KEY=
