{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aas.local/genome/schemas/lifecycle_event.schema.json",
  "title": "AAS Lifecycle Event",
  "description": "Event emitted during agent lifecycle transitions.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "repo",
    "event_type",
    "timestamp_utc"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "born",
        "trained",
        "stabilized",
        "specialized",
        "federated",
        "evolved",
        "retired",
        "degraded",
        "recovered"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
